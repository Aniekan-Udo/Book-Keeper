# Copy to .env and fill in. Never commit .env.

# Database (docker-compose builds POSTGRES_URI from these)
POSTGRES_USER=bookkeeper
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookkeeper
# for running outside docker:
# POSTGRES_URI=postgresql+asyncpg://bookkeeper:change-me@localhost:5432/bookkeeper

# Auth: long random string, different per environment
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true in production (HTTPS only)
COOKIE_SECURE=false
# comma-separated, only if the web client is served from another origin
ALLOWED_ORIGINS=

# public URL of the web app (used in WhatsApp sign-up links)
APP_PUBLIC_URL=

# WhatsApp Cloud API (channel stays off until all four are set) — see channels/whatsapp.py
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# the business number as digits (e.g. 2349012345678), for "Open WhatsApp" links on the website
WHATSAPP_DISPLAY_NUMBER=
# linked in the WhatsApp sign-up welcome; required before launch (Nigeria Data Protection Act)
PRIVACY_POLICY_URL=
# payment reminders: name of the approved template (reminders stay off until set)
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_REMINDER_TEMPLATE_LANG=en
REMINDER_COOLDOWN_DAYS=3
REMINDER_DAILY_LIMIT=20

# LLM: provider:model, see llm.py
LLM_MODEL=google_genai:gemini-2.5-flash
# model that listens to voice notes and reads alert screenshots; must accept audio and images
# (defaults to the Gemini model above)
TRANSCRIPTION_MODEL=
GOOGLE_API_KEY=

# Tracing (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OPIK_API_KEY=
OPIK_WORKSPACE=
